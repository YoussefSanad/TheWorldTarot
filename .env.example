APP_NAME="The World Tarot"
APP_ENV=local
APP_KEY=
# Never true on staging or production. A debug page leaks environment
# variables, including database and API credentials.
APP_DEBUG=true
# The full public URL of this API, including scheme. Signed URLs and the
# password reset links in transactional email are built from it.
# Production: https://api.theworldtarot.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The version label shown on the generated API reference at /docs/api.
API_VERSION=v1

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=the_world_tarot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local dev leaves this null. Staging and production set it to the shared root
# domain (.theworldtarot.com) so the Sanctum session cookie is readable by both
# the frontend and this API across subdomains. See CLAUDE.md section 3.
SESSION_DOMAIN=null

# The cookie's name, and it must differ per environment. A cookie is identified
# by name, domain and path, and both deployed environments scope theirs to
# .theworldtarot.com, so one name means the browser can only hold one of them.
# Signing into staging would then silently replace a production session, and the
# next production request answers 419 with nothing pointing at the cause.
# Staging: tarot_staging_session. Production: tarot_session.
SESSION_COOKIE=tarot_local_session

# Must be true anywhere served over HTTPS, which is both deployed environments.
# False locally, since local development is plain HTTP.
SESSION_SECURE_COOKIE=false

# lax is correct while the site and the API share a root domain, because a
# different subdomain is still the same site. It would need to become none, and
# SESSION_SECURE_COOKIE true, only if the frontend ever moves to another domain.
SESSION_SAME_SITE=lax

# Where the website lives. Every link in an email points here, never at this
# API, which renders nothing a customer can use.
#
# Per environment, and getting it wrong is not a broken link: a staging reset
# email carrying a production address sends somebody to the wrong site with a
# token the wrong site cannot use.
# Staging: https://staging.theworldtarot.com
# Production: https://prod.theworldtarot.com
FRONTEND_URL=http://localhost:3000

# The page on the website that finishes a password reset. Owned by the frontend
# partner, so it is configuration rather than a string in a mailable. It
# receives `token` and `email` as query parameters and must send both back here
# unchanged.
#
# Keep the trailing slash. The website is a static export built with
# `trailingSlash`, so the slashless form is a redirect on every mail link we
# send.
FRONTEND_RESET_PASSWORD_PATH=/reset-password/

# Where somebody who bought before they had an account chooses their first
# password. A different page from the reset, because nothing is being reset.
FRONTEND_SET_PASSWORD_PATH=/set-password/

# Where Stripe returns a customer who paid. It arrives holding a Checkout
# Session id, which it hands back to POST /api/v1/orders/status, because the id
# is opaque and a publishable key cannot resolve it. Keep the trailing slash.
FRONTEND_CHECKOUT_COMPLETE_PATH=/checkout/complete/

# The reading index, and the root of every reading page. Where a cancelled
# checkout lands, on the reading it started from when `return_to` named one.
# Keep the trailing slash.
FRONTEND_READINGS_PATH=/readings/

# Where somebody spends a gift code. One page for every reading, and the code
# travels as a query parameter rather than a path segment because the website is
# a static export and a path per code cannot be pre-rendered. Keep the trailing
# slash.
FRONTEND_REDEEM_PATH=/redeem/

# Both recipient keys below ship blank, and blank is safe. Read this before
# making one of them non-blank and then clearing it again.
#
# Every mail address in this file falls back with `?:` in config/mail.php and
# not with env()'s second argument, and that difference is the whole of the
# 13 August 2026 outage. env('KEY', 'default') applies its default only when
# KEY is **absent**. A KEY that is present and **blank** returns an empty
# string, and the default never runs. This template ships these keys present
# and blank, and `composer setup` copies it into place, so the documented
# default applied nowhere the template had been used: the address resolved to
# '', the one message telling Jennifer somebody was waiting for a reading was
# addressed to nobody, and the queue reported success. Nothing failed.
#
# A cleared field in a hosting panel leaves the same blank behind, and so does
# commenting out a value without commenting out its key. `?:` treats absent and
# blank alike, which is what makes leaving these untouched safe.

# Where "somebody is waiting for a reading" lands, orders@theworldtarot.com
# when this is blank. Asked for on 30 August 2026, and it needs a real mailbox
# behind it before the cutover, not after. Sending from an address is not
# receiving at one: point this somewhere nothing reads and every new order
# notification is accepted, delivered nowhere, and reported as a success.
MAIL_ORDERS_RECIPIENT=

# Where a disputed payment lands, fulfillment@theworldtarot.com when blank.
# Its own key rather than the one above, because a chargeback is not a new
# order and it is the one carrying a bank deadline.
#
# Must reach Jennifer, and a notification nobody reads is worse than none: the
# system reports success while a customer waits.
MAIL_FULFILLMENT_RECIPIENT=

# Origins allowed to call this API with credentials. Comma separated, no spaces,
# scheme included. A wildcard is not permitted alongside credentials.
# Local default is http://localhost:3000 when this is unset.
# Production example: https://theworldtarot.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Regex patterns for origins that cannot be listed literally, such as the
# Cloudflare Pages preview URLs. Comma separated. Empty until that URL exists.
# Example: ^https://[a-z0-9-]+\.theworldtarot-frontend\.pages\.dev$
CORS_ALLOWED_ORIGINS_PATTERNS=

# Hosts that receive a stateful session cookie rather than token auth. Comma
# separated hosts, no scheme. Must stay in step with CORS_ALLOWED_ORIGINS.
# Production example: theworldtarot.com,api.theworldtarot.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail goes through Resend. `log` writes messages to the log and sends nothing,
# which is right locally and silently wrong anywhere else: every send succeeds
# and nothing is delivered. Run `php artisan mail:check you@example.com` after
# changing this, and use --now to tell a broken transport apart from a queue
# worker that is not running.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_NAME="${APP_NAME}"

# From a Resend API key restricted to sending. It needs no other permission,
# and one that can also manage domains is a bigger credential than this
# application has any use for.
RESEND_API_KEY=

# Who each kind of message comes from, read through App\Enums\Sender. All three
# must sit on a domain verified in Resend, or mail is accepted and then filed as
# spam. MAIL_FROM_ADDRESS is only the fallback for anything that names no
# sender, and nothing in this application should.
#
# noreply@ replaced orders@ here on 30 August 2026: the customer's confirmation
# comes from it, and orders@ is a mailbox we write to now rather than a name we
# send under, so it moved to MAIL_ORDERS_RECIPIENT above. Nothing sends from
# orders@ any more.
#
# These four fall back with `?:` as well, for the reason written out in full at
# MAIL_ORDERS_RECIPIENT above. They ship with values rather than blank, so the
# way to get an empty one here is to clear it by hand.
MAIL_FROM_ADDRESS="support@theworldtarot.com"
MAIL_SUPPORT_ADDRESS="support@theworldtarot.com"
MAIL_NOREPLY_ADDRESS="noreply@theworldtarot.com"
MAIL_FULFILLMENT_ADDRESS="fulfillment@theworldtarot.com"

# Where the confirmation email loads its gold frame from, issue #53.
#
# An email client has no document base to resolve a relative path against, so
# every image in an HTML message needs an absolute address. Left blank this
# falls back to APP_URL plus /email, which is where the files are committed and
# is correct for local work and for both deployed environments.
#
# Set it only to move the images somewhere else, a CDN in front of this app or
# the platform bucket. Point it at a host that is not serving them and every
# receipt goes out with a broken frame, and nothing in the send path can detect
# that. See config/mail.php.
MAIL_ASSETS_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where anything the client uploads lives: card pictures now, video
# thumbnails from M4. "public" is a directory on this machine, which is
# correct locally.
#
# Leave it alone in deployed environments. Laravel Cloud publishes an
# attached bucket as LARAVEL_CLOUD_DISK_CONFIG, naming the disk it
# replaces, and config/filesystems.php applies that. So "public" is a
# directory here and the bucket there, with nothing to switch.
#
# `php artisan media:check` proves which one an environment is using.
MEDIA_DISK=public

# Where video masters go, which the public must never reach. Locally this
# is storage/app/private, which the web server does not serve.
#
# Leave it unset in deployed environments. The attached bucket that is not
# the environment's default is used automatically, because the platform
# names disks after the bucket and those names carry the environment in
# them. Set this only to override that, or when more than one private
# bucket is attached and there is nothing to guess.
# UPLOADS_DISK=

# Bunny Stream, per environment. A Stream library carries one webhook
# URL, so staging and production have separate libraries and sharing one
# means staging transcodes calling production.
#
# BUNNY_TOKEN_KEY is not the API key. It is the token authentication key
# in the library's settings, and it signs playback URLs. Confusing the two
# produces a 403 that reads like an expiry problem.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
BUNNY_CDN_HOSTNAME=

VITE_APP_NAME="${APP_NAME}"

# Mailchimp, the newsletter audience. **Both deployed environments share
# one audience**, so a signup made on staging reaches the list Jennifer
# mails. Set NEWSLETTER_DRIVER=log locally to write signups to the log
# instead of joining it.
#
# MAILCHIMP_SERVER_PREFIX is the datacenter, us20 here, and is its own
# variable rather than being split off the end of the key. Splitting works
# until a key arrives without the suffix, and then the failure reads like a
# revoked key rather than a config mistake.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
# NEWSLETTER_DRIVER=log

# Stripe, which collects the money. **Leave both blank locally.** Nobody has
# Jennifer's keys on a laptop, and config/payments.php only offers the card
# method where **both** of these are filled, so an empty value in either means
# an order waits to be settled by hand rather than meeting a button that breaks.
#
# Both, because the secret alone charges a card and the webhook secret is what
# hears that the charge succeeded. Half a configuration takes money it cannot
# then confirm.
#
# STRIPE_WEBHOOK_SECRET is issued **per endpoint** in the Stripe dashboard, not
# per account, so staging and production hold different values and the wrong
# one fails identically to a forged request. **A missing one refuses every
# webhook**, which is the safe direction: failing open here is failing open on
# granting paid access for free.
#
# For local webhook work, `stripe listen --forward-to
# localhost:8000/api/v1/webhooks/stripe` prints its own whsec_ to use here.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# PAYMENT_METHOD=stripe

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=the_world_tarot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local dev leaves this null. Staging and production set it to the shared root
# domain (.theworldtarot.com) so the Sanctum session cookie is readable by both
# the frontend and this API across subdomains. See CLAUDE.md section 3.
SESSION_DOMAIN=null

# Origins allowed to call this API with credentials. Comma separated, no spaces,
# scheme included. A wildcard is not permitted alongside credentials.
# Local default is http://localhost:3000 when this is unset.
# Production example: https://theworldtarot.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Regex patterns for origins that cannot be listed literally, such as the
# Cloudflare Pages preview URLs. Comma separated. Empty until that URL exists.
# Example: ^https://[a-z0-9-]+\.theworldtarot-frontend\.pages\.dev$
CORS_ALLOWED_ORIGINS_PATTERNS=

# Hosts that receive a stateful session cookie rather than token auth. Comma
# separated hosts, no scheme. Must stay in step with CORS_ALLOWED_ORIGINS.
# Production example: theworldtarot.com,api.theworldtarot.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
